//| mill-jvm-version: system|17
package build

import build.project.settings.{GenerateHeaders, JniModule, JniPublishModule, JniResourcesModule}
import build.project.publish.{computePublishVersion, gitCommitsSince, gitLastTag}
import build.project.utils.isArmArchitecture

import coursier.cache.ArchiveCache
import coursier.util.Artifact
import mill.*
import mill.api.BuildCtx
import mill.javalib.*
import mill.javalib.publish.*
import mill.javalib.SonatypeCentralPublisher
import mill.util.Tasks

import scala.concurrent.duration.Duration
import scala.util.Properties

object libsodiumjni extends MavenModule with JniModule with JniPublishModule with JniResourcesModule
    with GenerateHeaders:

  def windowsDllName = Task("libsodiumjni")
  def unixLibName    = Task("libsodiumjni")

  def unixLinkingLibs = Task {
    // On macOS, libsodium is built from source and linked statically (see unixLinkingArgs)
    if Properties.isMac then super.unixLinkingLibs()
    else super.unixLinkingLibs() ++ Seq("sodium")
  }

  // On macOS, -lsodium makes the dylib reference libsodium by its absolute install name
  // (e.g. /opt/homebrew/opt/libsodium/lib/libsodium.26.dylib), which only exists on machines
  // with Homebrew's libsodium. Linking the static archive makes the dylib self-contained.
  def unixLinkingArgs = Task {
    val libSodiumOpt = macosLibSodium()
    super.unixLinkingArgs() ++ libSodiumOpt.toSeq.flatMap { libSodium =>
      macosDeploymentTargetOptions ++ Seq(
        // fail if any linked object targets a newer macOS version than macosDeploymentTarget
        "-Wl,-fatal_warnings",
        (libSodium.path / "lib" / "libsodium.a").toString
      )
    }
  }

  /**
   * Oldest macOS version libsodiumjni.dylib loads on. 11.0 is the first macOS release supporting
   * Apple Silicon. Keep in sync with NativeLibraryLinkageTests.
   */
  private def macosDeploymentTarget        = "11.0"
  private def macosDeploymentTargetOptions = Seq(s"-mmacosx-version-min=$macosDeploymentTarget")

  // Same version as the Windows build. The checksum matches both download.libsodium.org and the
  // jedisct1/libsodium GitHub release asset.
  private def libsodiumVersion          = "1.0.21"
  private def libsodiumSourceTarballSha256 =
    "9e4285c7a419e82dedb0be63a72eea357d6943bc3e28e6735bf600dd4883feaf"

  /**
   * On macOS, libsodium built from source as a static library, targeting macosDeploymentTarget.
   * Pre-built static libraries (e.g. Homebrew's) target the macOS version they were built on, which
   * would prevent libsodiumjni.dylib from loading on older macOS versions.
   *
   * Returns the installation prefix (with `include` and `lib` sub-directories).
   */
  def macosLibSodium = Task {
    if !Properties.isMac then None
    else
      val arch    = if isArmArchitecture then "arm64" else "x86_64"
      val tarball = downloadLibSodiumSources()

      val srcDir = Task.dest / "src"
      val prefix = Task.dest / "install"
      os.makeDir.all(srcDir)
      os.proc("tar", "-xzf", tarball, "-C", srcDir, "--strip-components=1")
        .call(cwd = Task.dest)

      val flags = s"-arch $arch ${macosDeploymentTargetOptions.mkString(" ")}"
      val env   = Map(
        "CFLAGS"                   -> s"-O3 $flags",
        "LDFLAGS"                  -> flags,
        "MACOSX_DEPLOYMENT_TARGET" -> macosDeploymentTarget
      )
      val log = Task.dest / "build.log"
      def run(cmd: String*): Unit =
        System.err.println(s"Running ${cmd.mkString(" ")} (output in $log)")
        val res = os.proc(cmd).call(
          cwd = srcDir,
          env = env,
          stdout = os.ProcessOutput.Readlines(line => os.write.append(log, line + "\n")),
          mergeErrIntoOut = true,
          check = false
        )
        if res.exitCode != 0 then
          val tail = os.read.lines(log).takeRight(50).mkString(System.lineSeparator())
          sys.error(s"${cmd.mkString(" ")} exited with code ${res.exitCode}, last lines:\n$tail")
      run(
        "./configure",
        s"--prefix=$prefix",
        "--disable-shared",
        "--enable-static",
        "--with-pic",
        "--disable-dependency-tracking"
      )
      run("make", s"-j${Runtime.getRuntime.availableProcessors()}", "install")

      Some(PathRef(prefix))
  }

  private def downloadLibSodiumSources(): os.Path =
    val url   =
      s"https://download.libsodium.org/libsodium/releases/libsodium-$libsodiumVersion.tar.gz"
    val cache = coursier.cache.FileCache()
    val file  = cache.file(Artifact(url)).run.unsafeRun()(using cache.ec) match
      case Left(e)  => throw new Exception(e)
      case Right(f) => os.Path(f, BuildCtx.workspaceRoot)
    val digest = java.security.MessageDigest.getInstance("SHA-256").digest(os.read.bytes(file))
    val sha256 = digest.map(b => f"$b%02x").mkString
    if sha256 != libsodiumSourceTarballSha256 then
      sys.error(
        s"Unexpected SHA-256 for $url ($file): $sha256, expected $libsodiumSourceTarballSha256"
      )
    file

  private def checkLibraryArchitecture(libPath: os.Path, requiredArch: String): Boolean =
    if !Properties.isMac then return true // On Linux, assume compatibility
    if !os.exists(libPath) then return false

    // Check if library supports the required architecture using lipo or file
    val dylibPath =
      if libPath.last.endsWith(".dylib") then libPath
      else libPath / "libsodium.dylib"

    if !os.exists(dylibPath) then return false

    // Use lipo to check architectures (macOS only)
    val lipoResult = os.proc("lipo", "-info", dylibPath.toString).call(
      cwd = BuildCtx.workspaceRoot,
      check = false,
      stderr = os.Pipe
    )
    if lipoResult.exitCode == 0 then
      val output = lipoResult.out.trim()
      // Check if it's a universal binary or contains the required architecture
      output.contains(requiredArch) || output.contains("universal")
    else
      // Fallback: if lipo fails, assume it's compatible (might be a symlink or static lib)
      true

  private def unixLibSodiumLibDir(requiredArch: Option[String] = None): Option[String] =
    // Try pkg-config first
    val pkgConfigResult = os.proc("pkg-config", "--libs", "libsodium").call(
      cwd = BuildCtx.workspaceRoot,
      check = false,
      stderr = os.Pipe
    )
    if pkgConfigResult.exitCode == 0 then
      val output = pkgConfigResult.out.trim()
      // Extract -L path from pkg-config output (e.g., "-L/opt/homebrew/lib")
      val libPath = output.split(" ").find(_.startsWith("-L")).map(_.drop(2))
      if libPath.isDefined then
        val path = os.Path(libPath.get, BuildCtx.workspaceRoot)
        if os.exists(path) then
          // Check architecture compatibility if required
          if requiredArch.isEmpty || checkLibraryArchitecture(path, requiredArch.get) then
            return Some(libPath.get)
      // If pkg-config succeeds but no -L flag, library is in standard path
      // Return None to let the linker find it automatically
      return None
    // Fall back to common installation paths
    // On macOS, prioritize based on architecture: x86_64 -> /usr/local first, arm64 -> /opt/homebrew first
    val commonPaths = if Properties.isMac && requiredArch.contains("x86_64") then
      Seq(
        "/usr/local/lib",    // macOS Intel Homebrew (for x86_64 on Apple Silicon)
        "/opt/homebrew/lib", // macOS Homebrew (Apple Silicon)
        "/usr/lib"           // Standard macOS path
      )
    else if Properties.isMac && requiredArch.contains("arm64") then
      Seq(
        "/opt/homebrew/lib", // macOS Homebrew (Apple Silicon)
        "/usr/local/lib",    // macOS Intel Homebrew
        "/usr/lib"           // Standard macOS path
      )
    else
      Seq(
        "/opt/homebrew/lib",          // macOS Homebrew (Apple Silicon)
        "/usr/local/lib",             // macOS/Linux local install
        "/usr/lib/x86_64-linux-gnu",  // Ubuntu/Debian x86_64
        "/usr/lib/aarch64-linux-gnu", // Ubuntu/Debian arm64
        "/usr/lib64",                 // Some Linux distributions
        "/usr/lib"                    // Standard Linux path
      )
    commonPaths.find { path =>
      val libPath = os.Path(path)
      // Check if libsodium exists in this directory
      os.exists(libPath) && os.list(libPath).exists(_.last.startsWith("libsodium")) &&
      // Check architecture compatibility if required
      (requiredArch.isEmpty || checkLibraryArchitecture(libPath, requiredArch.get))
    }

  def unixLinkingLibPaths = Task {
    // On macOS, libsodium is built from source and linked statically (see macosLibSodium)
    val libDir = if Properties.isMac then None else unixLibSodiumLibDir()
    // If libDir is None, library is in standard path and linker will find it automatically
    super.unixLinkingLibPaths() ++ libDir.toSeq
  }

  private def unixLibSodiumIncludeDir(): String =
    // Try pkg-config first
    val pkgConfigResult = os.proc("pkg-config", "--cflags", "libsodium").call(
      cwd = BuildCtx.workspaceRoot,
      check = false,
      stderr = os.Pipe
    )
    if pkgConfigResult.exitCode == 0 then
      val output = pkgConfigResult.out.trim()
      // Extract -I path from pkg-config output (e.g., "-I/opt/homebrew/include")
      val includePath = output.split(" ").find(_.startsWith("-I")).map(_.drop(2))
      if includePath.isDefined && os.exists(os.Path(includePath.get, BuildCtx.workspaceRoot)) then
        return includePath.get
    // Fall back to common installation paths
    val commonPaths = Seq(
      "/opt/homebrew/include", // macOS Homebrew (Apple Silicon)
      "/usr/local/include",    // macOS/Linux local install
      "/usr/include"           // Standard Linux path
    )
    commonPaths.find(path => os.exists(os.Path(path) / "sodium.h")).getOrElse {
      val osName     = if Properties.isMac then "macOS" else "Linux"
      val installCmd =
        if Properties.isMac then "brew install libsodium" else "sudo apt-get install libsodium-dev"
      sys.error(
        s"libsodium headers not found on $osName. Please install libsodium (e.g., '$installCmd')"
      )
    }

  def extraUnixCOptions = Task {
    val includeDir = macosLibSodium() match
      case Some(libSodium) => (libSodium.path / "include").toString
      case None            => unixLibSodiumIncludeDir()
    Seq(s"-I$includeDir")
  }

  def unixCOptions = Task {
    super.unixCOptions() ++ extraUnixCOptions() ++
      (if Properties.isMac then macosDeploymentTargetOptions else Nil)
  }

  private def windowsLibSodiumDistDir(): os.Path =
    val archiveCache = ArchiveCache()
    archiveCache.get(
      Artifact("https://download.libsodium.org/libsodium/releases/libsodium-1.0.21-stable-msvc.zip")
    ).unsafeRun()(using archiveCache.cache.ec) match
      case Left(e)     => throw new Exception(e)
      case Right(dir0) => os.Path(dir0, BuildCtx.workspaceRoot)

  private def windowsLibSodiumDllDir(): os.Path =
    windowsLibSodiumDistDir() / "libsodium" / "x64" / "Release" / "v143" / "dynamic"

  def windowsLinkingLibs = Task {
    val dir = windowsLibSodiumDistDir()
    val lib = dir / "libsodium" / "x64" / "Release" / "v143" / "dynamic" / "libsodium"
    super.windowsLinkingLibs() ++ Seq(lib.toString)
  }
  def extraWindowsCOptions = Task {
    val dir       = windowsLibSodiumDistDir()
    val headerDir = dir / "libsodium" / "include"
    Seq(
      "/D__WIN__",
      "/I",
      headerDir.toString
    )
  }
  def windowsDllCOptions = Task {
    super.windowsDllCOptions() ++
      extraWindowsCOptions()
  }
  def windowsLibCOptions = Task {
    super.windowsLibCOptions() ++
      extraWindowsCOptions() ++
      Seq("/DSODIUM_STATIC")
  }
  def windowsBatInit = Task {
    import java.util.Locale
    val dllDir         = windowsLibSodiumDllDir()
    val pathEnvVarName = sys.env.find(_._1.toLowerCase(Locale.ROOT) == "path").fold("PATH")(_._1)
    "@echo on" + System.lineSeparator() +
      super.windowsBatInit() + System.lineSeparator() +
      s"""set "$pathEnvVarName=$dllDir;%$pathEnvVarName%""""
  }

  def jniArtifactDir = Task.Input {
    Task.env.get("CI").map(_ => PathRef(BuildCtx.workspaceRoot / "artifacts"))
  }

  // Task.Input: re-computed on every run, as it depends on the git state (tags, HEAD)
  def publishVersion = Task.Input {
    val lastTag = gitLastTag(BuildCtx.workspaceRoot)
    computePublishVersion(lastTag, lastTag.fold(0)(gitCommitsSince(BuildCtx.workspaceRoot, _)))
  }
  def pomSettings = PomSettings(
    description = artifactName(),
    organization = "org.virtuslab.scala-cli",
    url = "https://github.com/virtusLab/libsodiumjni",
    licenses = Seq(License.`Apache-2.0`),
    versionControl = VersionControl.github("virtusLab", "libsodiumjni"),
    developers = Seq(
      Developer("alexarchambault", "Alex Archambault", "https://github.com/alexarchambault")
    )
  )

  object test extends libsodiumjni.MavenTests:
    def mvnDeps = super.mvnDeps() ++ Seq(
      mvn"com.github.sbt:junit-interface:0.13.3"
    )
    def testFramework = "com.novocode.junit.JUnitFramework"
    def forkEnv       = Task {
      val env = super.forkEnv()
      if Properties.isWin then
        // libsodiumjni.dll links dynamically against libsodium.dll, which must be on the PATH
        import java.util.Locale
        val pathKey = (env.keys ++ sys.env.keys)
          .find(_.toLowerCase(Locale.ROOT) == "path")
          .getOrElse("PATH")
        val currentPath = env.get(pathKey).orElse(sys.env.get(pathKey))
        val newPath     = (windowsLibSodiumDllDir().toString +: currentPath.toSeq)
          .mkString(java.io.File.pathSeparator)
        env + (pathKey -> newPath)
      else env
    }

def publishSonatype(tasks: Tasks[PublishModule.PublishData]) =
  Task.Command {
    import scala.concurrent.duration.DurationInt
    // without a tag, the version is a placeholder (0.0.0-SNAPSHOT), which mustn't be released
    build.project.publish.requireTagForRelease(
      build.project.publish.gitLastTag(BuildCtx.workspaceRoot)
    )
    val timeout     = 10.minutes
    val pgpPassword = sys.env("PGP_PASSWORD")
    val data        = Task.sequence(tasks.value)()

    doPublishSonatype(
      username = sys.env("SONATYPE_USERNAME"),
      password = sys.env("SONATYPE_PASSWORD"),
      pgpPassword = pgpPassword,
      data = data,
      timeout = timeout,
      log = Task.log,
      workspace = BuildCtx.workspaceRoot,
      env = Task.env
    )
  }

def doPublishSonatype(
  username: String,
  password: String,
  pgpPassword: String,
  data: Seq[PublishModule.PublishData],
  timeout: Duration,
  log: mill.api.Logger,
  workspace: os.Path,
  env: Map[String, String]
): Unit =

  val artifacts = data.map { d =>
    (d.payloadAsMap.map((subPath, ref) => subPath -> ref.path), d.meta)
  }

  val isRelease =
    val versions = artifacts.map(_._2.version).toSet
    val set      = versions.map(!_.endsWith("-SNAPSHOT"))
    assert(
      set.size == 1,
      s"Found both snapshot and non-snapshot versions: ${versions.toVector.sorted.mkString(", ")}"
    )
    set.head

  // Sonatype Central Portal (replaces deprecated SonatypePublisher / Nexus)
  val creds     = SonatypeCredentials(username = username, password = password)
  val publisher = new SonatypeCentralPublisher(
    credentials = creds,
    gpgArgs = Seq(
      "--detach-sign",
      "--batch=true",
      "--yes",
      "--pinentry-mode",
      "loopback",
      "--passphrase",
      pgpPassword,
      "--armor",
      "--use-agent"
    ),
    readTimeout = timeout.toMillis.toInt,
    connectTimeout = timeout.toMillis.toInt,
    log = log,
    workspace = workspace,
    env = env,
    awaitTimeout = timeout.toMillis.toInt
  )
  val publishingType =
    if isRelease then PublishingType.AUTOMATIC
    else PublishingType.USER_MANAGED
  publisher.publishAll(
    publishingType = publishingType,
    singleBundleName = None,
    artifacts = artifacts*
  )
