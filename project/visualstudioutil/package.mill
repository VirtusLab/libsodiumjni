package build.project.visualstudioutil

import mill.api.BuildCtx

import scala.collection.concurrent.TrieMap

private def vcVersions = Seq("18", "2022", "2019", "2017")
private def vcEditions = Seq("Enterprise", "Community", "BuildTools")
private def vsDirs     = Seq(
  os.Path("""C:\Program Files\Microsoft Visual Studio"""),
  os.Path("""C:\Program Files (x86)\Microsoft Visual Studio""")
)

/**
 * Script setting up the Visual Studio environment to build native code for arch ("x86_64" or
 * "aarch64"), with the native tools for that architecture
 */
private def vcvarsScript(arch: String): String =
  arch match
    case "x86_64"  => "vcvars64.bat"
    case "aarch64" => "vcvarsarm64.bat"
    case other     => sys.error(s"Unsupported architecture on Windows: $other")

/** Visual Studio component providing the C / C++ build tools for arch */
private def vcToolsComponent(arch: String): String =
  arch match
    case "x86_64"  => "Microsoft.VisualStudio.Component.VC.Tools.x86.x64"
    case "aarch64" => "Microsoft.VisualStudio.Component.VC.Tools.ARM64"
    case other     => sys.error(s"Unsupported architecture on Windows: $other")

private def vswhereVcvars(arch: String): Option[String] =
  val vswhere =
    os.Path("""C:\Program Files (x86)\Microsoft Visual Studio\Installer\vswhere.exe""")
  if os.exists(vswhere) then
    val res = os.proc(
      vswhere,
      "-latest",
      "-products",
      "*",
      "-requires",
      vcToolsComponent(arch),
      "-property",
      "installationPath"
    ).call(check = false, stderr = os.Pipe)
    val installPath = res.out.trim()
    if res.exitCode == 0 && installPath.nonEmpty then
      Some(installPath + """\VC\Auxiliary\Build\""" + vcvarsScript(arch))
    else None
  else None

/**
 * VCVARSALL can point to one of the vcvars*.bat scripts (historically vcvars64.bat), whose
 * directory also has the scripts for the other architectures
 */
private def vcvarsFromEnv(arch: String): Option[String] =
  Option(System.getenv("VCVARSALL")).map { value =>
    val path = os.Path(value, BuildCtx.workspaceRoot)
    if path.last.equalsIgnoreCase(vcvarsScript(arch)) then path.toString
    else (path / os.up / vcvarsScript(arch)).toString
  }

private def vcvarsCandidates(arch: String): Seq[String] =
  vcvarsFromEnv(arch).toSeq ++ vswhereVcvars(arch).toSeq ++ {
    for
      version <- vcVersions
      edition <- vcEditions
      vsDir   <- vsDirs
    yield vsDir.toString + "\\" + version + "\\" + edition + """\VC\Auxiliary\Build\""" +
      vcvarsScript(arch)
  }

private val vcvarsCache = TrieMap.empty[String, os.Path]

/** vcvars*.bat script to set up the Visual Studio environment for arch ("x86_64" or "aarch64") */
def vcvars(arch: String): os.Path =
  vcvarsCache.getOrElseUpdate(
    arch,
    vcvarsCandidates(arch)
      .iterator
      .map(os.Path(_, BuildCtx.workspaceRoot))
      .find(os.exists(_))
      .getOrElse {
        val script = vcvarsScript(arch)
        sys.error(
          s"$script not found. Ensure Visual Studio is installed, with the C++ build tools for " +
            s"$arch, or put the path of a vcvars*.bat script in VCVARSALL."
        )
      }
  )
