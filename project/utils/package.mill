package build.project.utils

import java.util.Locale

def toCrLfOpt(content: Array[Byte]): Option[Array[Byte]] =
  val cr      = '\r'.toByte
  val lf      = '\n'.toByte
  val indices = content
    .iterator
    .zipWithIndex
    .collect {
      case (`lf`, idx) if idx > 0 && content(idx - 1) != cr => idx
    }
    .toVector
  if indices.isEmpty then
    None
  else
    val updatedContent = Array.ofDim[Byte](content.length + indices.length)
    var i              = 0 // content index
    var j              = 0 // updatedContent index
    var n              = 0 // indices index
    while n < indices.length do
      val idx = indices(n)

      System.arraycopy(content, i, updatedContent, j, idx - i)
      j += idx - i
      i = idx

      updatedContent(j) = cr
      updatedContent(j + 1) = lf
      i += 1
      j += 2

      n += 1

    val idx = content.length
    System.arraycopy(content, i, updatedContent, j, content.length - i)
    j += idx - i
    i = idx

    assert(i == content.length)
    assert(j == updatedContent.length)
    Some(updatedContent)
/**
 * CPU architecture the native libraries are built for, as "x86_64" or "aarch64".
 *
 * That's the architecture of the JVM running the build, as given by its "os.arch" property, like
 * libsodiumjni.internal.LoadLibrary.resourcePath() at runtime, so that the tests of a build load
 * the library it just built. (On macOS, under Rosetta, the JVM and the processes it starts are
 * x86_64.)
 */
def hostArch: String =
  sys.props("os.arch").toLowerCase(Locale.ROOT) match
    case "amd64" | "x86_64"  => "x86_64"
    case "aarch64" | "arm64" => "aarch64"
    case other               => sys.error(s"Unsupported architecture: $other")

def isArmArchitecture: Boolean =
  hostArch == "aarch64"

/**
 * Directory, under META-INF/native in the JAR, of the native library with the passed classifier.
 *
 * Must match libsodiumjni.internal.LoadLibrary.resourcePath().
 */
def nativeResourceDir(classifier: String): String =
  classifier match
    case "x86_64-apple-darwin"  => "darwin"
    case "aarch64-apple-darwin" => "arm-darwin"
    case "x86_64-pc-linux"      => "linux64"
    case "aarch64-pc-linux"     => "linux-aarch64"
    case "x86_64-pc-win32"      => "windows64"
    case "aarch64-pc-win32"     => "windows-aarch64"
    case other                  => sys.error(s"Unrecognized classifier: $other")
