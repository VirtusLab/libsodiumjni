package build.project.utils

import java.util.Locale

def toCrLfOpt(content: Array[Byte]): Option[Array[Byte]] =
  val cr      = '\r'.toByte
  val lf      = '\n'.toByte
  val indices = content
    .iterator
    .zipWithIndex
    .collect {
      case (`lf`, idx) if idx > 0 && content(idx - 1) != cr => idx
    }
    .toVector
  if indices.isEmpty then
    None
  else
    val updatedContent = Array.ofDim[Byte](content.length + indices.length)
    var i              = 0 // content index
    var j              = 0 // updatedContent index
    var n              = 0 // indices index
    while n < indices.length do
      val idx = indices(n)

      System.arraycopy(content, i, updatedContent, j, idx - i)
      j += idx - i
      i = idx

      updatedContent(j) = cr
      updatedContent(j + 1) = lf
      i += 1
      j += 2

      n += 1

    val idx = content.length
    System.arraycopy(content, i, updatedContent, j, content.length - i)
    j += idx - i
    i = idx

    assert(i == content.length)
    assert(j == updatedContent.length)
    Some(updatedContent)
/**
 * CPU architecture the native libraries are built for, as "x86_64" or "aarch64".
 *
 * That's the architecture of the JVM running the build, as given by its "os.arch" property, like
 * libsodiumjni.internal.LoadLibrary.resourcePath() at runtime, so that the tests of a build load
 * the library it just built. (On macOS, under Rosetta, the JVM and the processes it starts are
 * x86_64.)
 */
def hostArch: String =
  sys.props("os.arch").toLowerCase(Locale.ROOT) match
    case "amd64" | "x86_64"  => "x86_64"
    case "aarch64" | "arm64" => "aarch64"
    case other               => sys.error(s"Unsupported architecture: $other")

def isArmArchitecture: Boolean =
  hostArch == "aarch64"

/**
 * Supported platforms: classifier -> directory, under META-INF/native in the JAR, of its native
 * library.
 *
 * Must match libsodiumjni.internal.LoadLibrary.resourcePath(), the README, and
 * .github/scripts/check-release-natives.sh (checked by PlatformTableTests, which gets this table
 * from the build).
 */
val nativeResourceDirs: Seq[(String, String)] = Seq(
  "x86_64-pc-linux"      -> "linux64",
  "aarch64-pc-linux"     -> "linux-aarch64",
  "x86_64-apple-darwin"  -> "darwin",
  "aarch64-apple-darwin" -> "arm-darwin",
  "x86_64-pc-win32"      -> "windows64",
  "aarch64-pc-win32"     -> "windows-aarch64"
)

/** Directory, under META-INF/native in the JAR, of the native library with the passed classifier */
def nativeResourceDir(classifier: String): String =
  nativeResourceDirs.toMap.getOrElse(classifier, sys.error(s"Unrecognized classifier: $classifier"))

/** Hex-encoded SHA-256 of a file */
def sha256Hex(file: os.Path): String =
  val digest = java.security.MessageDigest.getInstance("SHA-256")
  val is     = os.read.inputStream(file)
  try
    val buf = new Array[Byte](1 << 16)
    var n   = is.read(buf)
    while n >= 0 do
      digest.update(buf, 0, n)
      n = is.read(buf)
  finally is.close()
  digest.digest().map(b => f"$b%02x").mkString

/** Fails if file (downloaded from url) doesn't have the expected SHA-256 */
def checkSha256(file: os.Path, url: String, expectedSha256: String): Unit =
  val actual = sha256Hex(file)
  if expectedSha256.isEmpty || actual != expectedSha256.toLowerCase(Locale.ROOT) then
    sys.error(s"Unexpected SHA-256 for $url ($file): $actual, expected $expectedSha256")

/**
 * Text of a license written as a C comment, like libsodium's LICENSE file ("/*", then lines
 * starting with " * ", then " */"), without the comment markers, with \n line endings
 */
def uncommentLicense(text: String): String =
  text
    .linesIterator
    .filterNot(line => line.trim == "/*" || line.trim == "*/")
    .map(line => line.stripPrefix(" *").stripPrefix(" "))
    .mkString("\n")
